# Secrets
.env
# Backups of it are the same secrets under a different name.
.env.bak*
.env.*.bak

# Generated media / artifacts
output/
assets/visuals/*
!assets/visuals/.gitkeep

# Music beds: yours, and yours to have licensed. The credit sidecars are text
# worth keeping; the audio is not something to commit.
assets/music/*
!assets/music/.gitkeep
!assets/music/*.txt

# Sound effects: same deal as the music. Drop your own one-shots in; the audio
# is not something to commit.
assets/sfx/*
!assets/sfx/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

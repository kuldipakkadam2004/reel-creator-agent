# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Step 2: script generation (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Step 3: text-to-speech (ElevenLabs) ---
ELEVENLABS_API_KEY=
# Optional. Falls back to a premade voice if left blank.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Step 4: visual sourcing ---
# Providers are queried in this order; any without a key is skipped with a
# warning rather than failing the run. `openverse` needs no key at all, so
# sourcing still works on an empty .env - just not well.
VISUAL_PROVIDERS=pexels,pixabay,openverse

# Free key, instant: https://www.pexels.com/api/   (best vertical video)
PEXELS_API_KEY=
# Free key, instant: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# The old step-1 placeholder name. Still honoured as the Pexels key.
STOCK_API_KEY=

# Resolution floor, applied AFTER a centre crop to 9:16 - so a 4K landscape
# clip passes and a 1920x1080 one does not. Defaults to the VIDEO_* frame
# below. Lower these to accept footage that will be upscaled a little.
VISUAL_MIN_WIDTH=1080
VISUAL_MIN_HEIGHT=1920

# Assets fetched per visual beat. Above 1 gives step 5 alternates to cut
# between without going back to the network.
VISUAL_ASSETS_PER_BEAT=2

# Source this multiple of the narration length, so step 5 has slack to pace
# cuts. 1.6 = 60% more footage than there is narration.
VISUAL_DURATION_HEADROOM=1.6

# Skip an asset used within this many previous runs, so the same stock clip
# does not open every video. 0 disables the cooldown.
VISUAL_REUSE_COOLDOWN_RUNS=3

# Stills are allowed as filler; VISUAL_IMAGE_DURATION is how long one is
# assumed to hold the screen when counting coverage.
VISUAL_ALLOW_IMAGES=true
VISUAL_IMAGE_DURATION=4.0

# Accept landscape sources that survive the 9:16 crop above.
VISUAL_ALLOW_LANDSCAPE=true

# llm       = one Gemini call writes a search query per beat (falls back to
#             `heuristic` by itself if the call fails)
# heuristic = keyword extraction only, no API call
VISUAL_QUERY_MODE=llm

# --- Step 6: Instagram caption + hashtags ---
# Reuses GEMINI_API_KEY from step 2. Everything below is optional - the
# defaults in config.py are the ones described here.

# llm       = Gemini writes the caption and tags from the script
# heuristic = lines lifted from the script + keyword tags, no API call
POST_MODE=llm

# The voice of every caption. This is the knob to turn first.
POST_TONE=curious and plainspoken - short lines, concrete detail, no hype stacking and no engagement bait

# What the closing line should do. Leave blank for no CTA.
POST_CTA=ask one question the post genuinely wants answered in the replies

# The account's subject area, used to steer the broad end of the tag mix.
# Blank = infer it from the script.
POST_NICHE=

# Instagram's hard caption limit, and the point at which the feed cuts a
# caption off with "... more". The first line is built to survive that cut.
POST_MAX_CHARS=2200
POST_HOOK_MAX_CHARS=125

# Instagram allows 30 tags and advises 3-5. 8 is enough for the recommender to
# place the reel without the caption reading as spam.
POST_HASHTAG_COUNT=8

# caption = tags close the caption
# comment = tags are kept out and written to post_comment.txt for step 7
POST_HASHTAG_PLACEMENT=caption

# Tags added to every post whatever the topic (a brand or series tag).
POST_HASHTAGS_ALWAYS=
# Tags never to use. Defaults to engagement bait that limits reach.
POST_HASHTAGS_BANNED=follow4follow,followforfollow,like4like,likeforlike,f4f,l4l,tagsforlikes,followback,followme
# Tags used by the last N posts are treated as "recently used" so consecutive
# posts do not carry an identical block. 0 disables it.
POST_HASHTAG_HISTORY_RUNS=5

# Words the copy must never contain, and phrases it must always contain.
POST_BANNED_WORDS=
POST_MUST_INCLUDE=

# A couple of emoji read as native; a row of them reads as a brand account.
POST_ALLOW_EMOJI=true
POST_MAX_EMOJI=2

# What to do with step 4's credits:
#   required = only what a licence demands (Pexels/Pixabay demand nothing)
#   all      = also add a courtesy "via Pexels" line
#   off      = never touch the caption
POST_ATTRIBUTION=required
POST_ATTRIBUTION_HEADER=Footage:
POST_ATTRIBUTION_MAX=6

# --- Step 7: Telegram delivery ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: video defaults (used from step 4 onward) ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Step 0: topic scouting ---
# Where the topic comes from when you have not brought one. Everything here is
# optional: with an empty .env the trends source still returns a board.
#
# reddit    = hot posts in your own subreddits (the best source - a post title
#             is a hook a human wrote and upvotes already tested). Needs a free
#             "script" app; Reddit no longer serves .json anonymously.
# redditrss = the same subreddits over Reddit's public Atom feeds, which DO
#             still serve without a key. Keeps the titles, loses the scores and
#             comment counts, and stands in for velocity with the post's place
#             in the listing - see TOPIC_REDDIT_LISTING. This is the one to
#             use with no Reddit key.
# youtube   = videos from the last month ranked by views per day
# trends    = Google's daily trending searches RSS, keyless and general-news
# wikipedia = articles read more than the same weekday last week. Keyless,
#             official, and the only free source that measures a rise rather
#             than a level. General interest, so it scores down against a niche.
TOPIC_SOURCES=redditrss,wikipedia,youtube,trends

# What the account is about. Steers the youtube search and is what the niche
# pass judges candidates against. Blank falls back to POST_NICHE (step 6).
#
# Write it as a subject, not as keywords - it is read by a model, so "the ocean
# and how the earth works" is a better description than "ocean,earth,science".
TOPIC_NICHE=

# What an off-niche candidate is worth, and how "off-niche" is decided.
#
#   TOPIC_NICHE_MODE   gate   hold it off the board while there is anything
#                             on-niche to show, backfilling and warning when
#                             there is not
#                      prefer score it down and let it compete
#                      off    do not judge the subject at all
#
#   TOPIC_NICHE_MATCH  llm    one Gemini call reads the shortlist and answers
#                             on/off for each. Falls back to `terms` if it fails
#                      terms  a word from TOPIC_NICHE appears in the topic.
#                             Free, and much stricter than it sounds: measured
#                             on one board it placed NONE of 59 candidates
#                             on-niche, "caves beneath the Moon" included
TOPIC_NICHE_MODE=gate
TOPIC_NICHE_MATCH=llm

# Subreddits to read, without the r/. No default - whose feed this is depends
# on the account. Blank means the reddit source is skipped.
#
# Narrow beats broad here, and it is the single biggest lever on board quality.
# r/todayilearned and r/science will fill a board every day, but they are about
# everything, so most of what they return is something the niche pass then has
# to throw away. Two or three subreddits that are actually about your subject
# produce a better board than ten large ones.
TOPIC_SUBREDDITS=

# Which Reddit listing to read, and over what window when it is `top`.
# hot/top/new/rising, and hour/day/week/month/year/all.
#
# `top` of the week by default. `hot` is what is moving in the next few hours,
# which is the right question for a news desk and the wrong one here: a reel
# takes a Gemini call, an ElevenLabs render and a full encode, and it lands
# long after a breaking story has been covered by everyone who only had to talk
# to a camera. `top` is the same crowd's verdict taken after the churn cleared.
TOPIC_REDDIT_LISTING=top
TOPIC_REDDIT_WINDOW=week

# How many separate feed requests the subreddit list is read over.
#
# Reddit ranks a combined r/a+b+c listing by absolute score, and a list picked
# for a niche mixes default subs of 38M members with specialist ones of 90k.
# Measured on board #31: nine subreddits read as ONE feed returned forty
# entries from two of them - 33 from r/todayilearned, 2 from r/science - and
# all 33 were then rejected off the niche, because that sub's top of the month
# is film trivia and sports anecdotes. The seven subreddits chosen *for* the
# niche returned nothing at all, and the board fell back to the evergreen
# backlog, as it had every day before it.
#
# Splitting the list gives each group its own listing, so a small subreddit
# competes against its own size. 2 is a measured ceiling, not a preference:
# from a cold address, three feeds 4s apart lost two of them to a 429 and
# three feeds 20s apart still lost the third, while two feeds 20s apart both
# came back. The gap is RedditRssSource.FEED_GAP_SECONDS, a feed refused
# costs only its own subreddits, and which group goes first rotates by the day
# so the same ones are not the ones lost every time. Set 1 for the old
# single-feed behaviour.
#
# Set REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET and TOPIC_SOURCES=reddit to be
# rid of the ceiling entirely - the authenticated API allows 60 a minute, and
# it carries upvotes and comment counts the RSS feed does not have.
TOPIC_REDDIT_FEEDS=2

# Search terms for the youtube source. Blank falls back to TOPIC_NICHE.
# Query strings, not a description of the account - they are not read as the
# niche (a keyword of "natural world" once made a hockey World Cup on-niche).
TOPIC_KEYWORDS=

# Only the `reddit` source needs these; `redditrss` needs nothing. Reddit used
# to serve the public .json endpoints to anything with a User-Agent; an
# unauthenticated read now answers 403 with a block page, while the .rss feeds
# beside them still answer 200 - which is what `redditrss` reads. Set these if
# you can get them: scores and comment counts are worth the two minutes, and
# they are the two largest scoring inputs. A free "script" app:
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:reel-creator-agent:0.1 (topic scouting)

# YouTube Data API v3. Free quota is 10,000 units/day; a search costs 100.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# How many candidates the board shows, and how deep each source is read.
TOPIC_CANDIDATES=8
TOPIC_PER_SOURCE=25

# Older than this is scored down as past its peak. Arriving late to a trend is
# worse than being evergreen: the same competition, none of the window.
TOPIC_MAX_AGE_HOURS=72

# How far back the youtube source looks, and the region for the trends feed.
TOPIC_YOUTUBE_WINDOW_DAYS=30
TOPIC_TRENDS_GEO=US

# Which Wikipedia the pageviews source reads. A language edition, not a country.
TOPIC_WIKI_PROJECT=en.wikipedia

# Check that step 4 could actually find footage before recommending a topic.
# llm   = ask the model whether a stock library could show this. The default.
# probe = search the stock providers and read how many of the results are
#         genuinely about the topic. off = do not ask.
#
# `probe` was the default until it was measured, on 2026-09-02, over 439
# results from six known-good topics and five known-bad ones. It does not
# separate them at any threshold: "why a purple hexagon dreams of accounting"
# scored 20/20 on Pixabay against 20/20 for a real topic, and across the whole
# evergreen backlog the count averaged 19.82 of 20 - a component that is the
# same number for every candidate does no ranking at all. The reason is that
# the probe searches three keywords stripped out of the topic, so "State Farm
# dividend" honestly retrieves farm footage: the results are right and the
# query was the wrong question. Reading more results cannot fix that, so the
# question is now asked of something that can read the topic instead.
#
# The cost is one extra Gemini call per board, batched across the shortlist.
# The two settings below apply to `probe` only; under `llm` the model rates
# each topic 0-3 and the rating is mapped onto TOPIC_SOURCEABLE_HITS.
TOPIC_SOURCEABILITY=llm
TOPIC_PROBE_SAMPLE=8
TOPIC_SOURCEABLE_HITS=3
# Only the top N candidates are probed - the free scoring picks who is worth it.
TOPIC_PROBE_LIMIT=16

# How the winning titles become topic phrases for step 2.
# llm = one Gemini call rewrites the shortlist (it rewrites only - the ranking
#       was settled in code before the model was asked)
# heuristic = strip the forum furniture locally, no call
TOPIC_PHRASE_MODE=llm

# Topics shown on the last N boards are scored down; one already made into a
# reel is dropped. 0 disables the ledger.
TOPIC_HISTORY_RUNS=20

# Refusals a topic gets before the board stops offering it. A script the
# fact-check refuses costs a ~150s Pro call and leaves nothing behind, and the
# board used to have no memory of one at all - a topic is marked "used" only
# once money has gone on it, which a refused draft never reaches. Measured:
# "what the sound of the deep ocean actually is" was chosen and refused five
# times over 26 boards before a draft survived. The first refusal is priced
# (topics.REFUSED_PENALTY, -1.2); the second drops the topic. 0 turns it off.
TOPIC_MAX_REFUSALS=2

# Reading a board and choosing from it are two commands, so the board you just
# looked at is saved and `--take N` acts on THAT one rather than scouting again.
# Without this the two commands see two different boards - a source that gets
# rate limited on the second pass silently drops out of the choice. Past this
# many minutes the saved board is stale and --take looks again; --rescout
# forces a fresh look at any time. 0 disables the reuse.
TOPIC_BOARD_TTL_MINUTES=60

# Words that disqualify a candidate outright. Empty by default.
TOPIC_BANNED_WORDS=

# --- Step 2: script generation (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# How long one Gemini call may go unanswered before it is abandoned, in
# seconds. The SDK ships no default, so a request that is never answered just
# waits: on 2026-09-09 the first call of step 2 held an open connection for
# fourteen minutes, burning no CPU, and the run had to be killed by hand. A
# hang raises nothing, so the retry never sees it; a timeout raises, and the
# retry already handles that kind of error. Generous against a slow pro call -
# step 2's four calls together take about 150s - finite against a dead one.
GEMINI_TIMEOUT_SECONDS=120

# --- Optional: step 2 reel length ---
# How long a reel should be is a decision, not a flag with a number in it.
# Completion is what the ranking runs on, so a 30-second reel watched to the
# end beats a 45-second one abandoned at 15, and a single fact stretched to 45
# seconds is padding the viewer leaves during.
#
# Step 0 suggests a length per topic from the shape signals it already has - a
# mechanism ("why the ocean is salty") is given longer than a fixture, an
# argument longer than an announcement, and thin stock footage shortens a reel
# rather than filling it with the same three clips coming round again. The
# board prints that length with the parts it was built from and puts it in the
# script_gen command it suggests.
#
# SCRIPT_DEFAULT_SECONDS is the fallback for when nobody had an opinion:
# script_gen.py with no -d. MIN/MAX bound what step 0 may suggest, not what -d
# may ask for.
SCRIPT_DEFAULT_SECONDS=30
SCRIPT_MIN_SECONDS=20
SCRIPT_MAX_SECONDS=45
SCRIPT_DURATION_STEP_SECONDS=5   # 31s is not a more considered answer than 30

# --- Optional: step 2 hook pass ---
# A reel is decided in its first second and a half, and all of that rests on
# one sentence. HOOK_MODE=llm spends a second Gemini call writing several
# openings, scores them in code against the one the scriptwriter produced, and
# only promotes a winner if it actually beats it. `off` keeps the original.
HOOK_MODE=llm
HOOK_VARIANTS=5                  # openings to write before choosing
HOOK_MAX_WORDS=14                # longer than this is a paragraph, not a hook
HOOK_CARD_MAX_WORDS=6            # the on-screen form, read at a glance

# --- Optional: step 2 structure pass ---
# The hook pass buys the first second and a half; this one is about the thirty
# after it. STRUCTURE_MODE=llm scores the shape of the whole script in code -
# whether the close pays the opening off instead of repeating it, whether
# anything turns in the middle, whether the last line is short enough to land -
# and buys one rewrite for a script that has no shape, keeping it only if it
# scores better. `off` writes the script once and takes what comes back.
STRUCTURE_MODE=llm
# The score at or above which no rewrite is bought. 2.0 is the score of a script
# that closes its loop and does nothing else, so the line it draws is one
# sentence long: close your loop and you are never rewritten for polish, fail to
# and you always are. 3.7 is the ceiling (every component firing); below 0 keeps
# the scoring as a report that is never acted on.
STRUCTURE_MIN_SCORE=2.0

# --- Optional: step 2 take-away pass ---
# The passes above buy attention; this one asks what the viewer is left holding
# when the reel stops. It exists because of the account: across the 7 reels
# posted to 2026-09-08, watch-through runs 0.38-0.68 - the retention those
# passes were built for, working - and saves and shares are 0 on every one of
# them. A reel nobody keeps and nobody sends is shown to nobody else.
# TAKEAWAY_MODE=llm scores whether the script puts the viewer in front of the
# thing ("next time you...", "you'll see it in..."), names it so they can
# repeat it, and leaves them in the closing lines - and buys one rewrite for a
# script that does none of those, keeping it only if it scores better AND its
# shape survives. `off` scores it and acts on nothing.
TAKEAWAY_MODE=llm
# The score at or above which no rewrite is bought. 2.0 is the weight of the
# transfer line alone, so one sentence putting the viewer in front of the thing
# clears it outright, as does a name plus the viewer in the close (1.2 + 0.8).
# 4.0 is the ceiling. Measured over the 29 scripts written before this pass
# existed, 28 of them would buy a call - they were written to a prompt that
# never asked. Judge the firing rate on reels made after it, not before.
TAKEAWAY_MIN_SCORE=2.0

# --- Optional: step 2 claim check ---
# The two passes above ask whether the script is shaped like a reel. Neither
# asks whether it is true. The glacier reel opened on ice "moving at your
# walking speed" and said "a few centimetres a day" eleven sentences later; the
# Oakland Zoo reel narrated a crimson mountain lion that does not exist, gave
# it a real cougar's name, and closed on "Come see her". Both are well shaped.
#
# VERIFY_MODE=llm spends one Gemini call looking for self-contradictions and
# false claims. A finding has to quote a sentence the script actually contains
# or it is thrown away. A faulty script buys a repair, which is re-checked and
# kept only if it cleared something; what survives that is refused, and step 8
# treats a refused script as a dead-end topic and falls through to the next
# candidate on the board. `off` publishes whatever the script asserts.
VERIFY_MODE=llm

# How many rewrites a refused script may buy before the topic is given up.
#
# One was measured too few. On 2026-09-02 two runs discarded six topics in a
# row, each on a single failed repair, and the findings behind them were the
# mechanical kind a second attempt lands: "all that water flashes to steam"
# wanting "some of it", "ninety-nine percent gone. Total darkness" wanting
# "effectively dark". A round costs two calls; falling through to a fresh
# candidate costs a whole generation and then usually fails the same way,
# because the fault is in how a 40-second narration is written rather than in
# which topic it is about.
#
# Rounds stop early only when a rewrite comes back with MORE blocking findings
# than it went in with. One that holds level is tried again: the repair is a
# sampled call and can miss once and land the next time. Demanding a strict
# reduction made this setting inert for a script with a single blocking
# finding - the common case - which is how 2026-09-03 lost both its topics.
#
# Counted from the last round that brought the finding count DOWN, not from
# the first round. A repair that is converging is not the spend this bounds:
# measured 2026-09-05, the tuna draft went 3 blocking findings -> 2 -> 1 and
# was refused there, having improved on every round it was given. Rounds that
# hold level spend this budget; a round that improves gives it back.
VERIFY_REPAIR_ROUNDS=2
# The hard ceiling on repair rounds for one script, however well it is going.
# Strict improvement is self-limiting - the count cannot fall more times than
# it started at - so this mostly bounds the bill on a draft that starts with a
# dozen faults and grinds them off one at a time. At that point the draft is
# the problem and the next topic is cheaper. Two calls a round.
VERIFY_REPAIR_MAX_ROUNDS=5

# --- Step 3: text-to-speech (ElevenLabs) ---
ELEVENLABS_API_KEY=
# Optional. Falls back to a premade voice if left blank.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
#
# Delivery. These were ElevenLabs' own defaults hard-coded in pipeline/tts.py -
# a neutral read for a format that is not neutral. Knobs now, because a
# narrator is worth trying variants of and step 9 can only trial what it can
# set.
TTS_STABILITY=0.4                # 0.4-0.6 suits narration; lower = more range
TTS_SIMILARITY_BOOST=0.75        # timbre match; too high reproduces artefacts
TTS_STYLE=0.25                   # exaggeration; costs latency and stability
TTS_SPEAKER_BOOST=true           # small clarity bump, free
# Playback rate, 0.7-1.2. The one number here that is a judgement about the
# format rather than a measurement of this pipeline: short-form narration sits
# a little above a natural read. Nothing in output/ can confirm it - every reel
# so far was made at 1.0 - so it is worth a PERFORMANCE_EXPLORE arm.
TTS_SPEED=1.08
# How fast the narration is spoken at TTS_SPEED=1.0. Step 2 multiplies the two
# to turn a target length into a word count, so speeding the read up lengthens
# the script instead of shortening the reel. Measured over the thirteen reels
# on disk at 153.2 wpm mean against the 150 assumed, so 150 stays.
SCRIPT_WORDS_PER_MINUTE=150

# --- Step 4: visual sourcing ---
# Providers are queried in this order; any without a key is skipped with a
# warning rather than failing the run. `openverse` needs no key at all, so
# sourcing still works on an empty .env - just not well.
#
# Two more are available and left off by default:
#
#   youtube - video, Creative Commons uploads only (videoLicense=creativeCommon).
#             Reuses YOUTUBE_API_KEY from step 0 and needs `pip install yt-dlp`.
#             Two things to know before enabling it. Each search costs 100 of
#             the 10,000 daily quota units the topic scout also draws on, so a
#             ten-beat reel is ~1,000 units. And YouTube is a 16:9 library while
#             the floor below is applied AFTER the 9:16 crop - so at the default
#             1080x1920 only genuinely 4K uploads survive. Enabling this without
#             lowering VISUAL_MIN_WIDTH/HEIGHT will source very little.
#   nasa    - photo only, no key, public domain, frequently 4000px+. Nothing to
#             say outside space and earth science; excellent inside it.
#
# VISUAL_PROVIDERS=pexels,pixabay,openverse,nasa,youtube
VISUAL_PROVIDERS=pexels,pixabay,openverse

# Per-provider resolution floors, as name:WIDTHxHEIGHT, overriding
# VISUAL_MIN_WIDTH/HEIGHT for that provider only. The floor is measured AFTER
# the 9:16 crop, so what it costs depends on the shape of the library: the
# stock providers are portrait-first and clear 1080x1920 easily, while YouTube
# is 16:9 and would have to be 4K to.
#
# The default lets ordinary 1080p YouTube through - 608x1080 is exactly what
# 1920x1080 leaves after the crop - which means ~78% upscaling in the final
# frame. Set it to youtube:810x1440 to demand 1440p instead (~33% upscale), or
# clear it entirely to hold YouTube to the same bar as everything else.
VISUAL_PROVIDER_FLOORS=youtube:608x1080

# Free key, instant: https://www.pexels.com/api/   (best vertical video)
PEXELS_API_KEY=
# Free key, instant: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# The old step-1 placeholder name. Still honoured as the Pexels key.
STOCK_API_KEY=

# Resolution floor, applied AFTER a centre crop to 9:16 - so a 4K landscape
# clip passes and a 1920x1080 one does not. Defaults to the VIDEO_* frame
# below. Lower these to accept footage that will be upscaled a little.
VISUAL_MIN_WIDTH=1080
VISUAL_MIN_HEIGHT=1920

# Assets fetched per visual beat. Above 1 gives step 5 alternates to cut
# between without going back to the network.
VISUAL_ASSETS_PER_BEAT=2

# Source this multiple of the narration length, so step 5 has slack to pace
# cuts. 1.6 = 60% more footage than there is narration.
VISUAL_DURATION_HEADROOM=1.6

# Skip an asset used within this many previous runs, so the same stock clip
# does not open every video. 0 disables the cooldown.
VISUAL_REUSE_COOLDOWN_RUNS=3

# Stills are allowed as filler; VISUAL_IMAGE_DURATION is how long one is
# assumed to hold the screen when counting coverage.
VISUAL_ALLOW_IMAGES=true
VISUAL_IMAGE_DURATION=4.0

# Accept landscape sources that survive the 9:16 crop above.
VISUAL_ALLOW_LANDSCAPE=true

# llm       = one Gemini call writes a search query per beat (falls back to
#             `heuristic` by itself if the call fails)
# heuristic = keyword extraction only, no API call
VISUAL_QUERY_MODE=llm

# Whether a clip is checked against the beat it will play under before it is
# allowed on screen. A stock library answers every query with something and
# ranks it on how well it is shot, not on what it shows - so an unscreened run
# answers "Hadza hunter gatherers" with a well-shot black bear and ships it.
# llm     = one Gemini call screens every beat's shortlist at once (falls back
#           to `lexical` by itself if the call fails)
# lexical = keep only clips whose own words overlap the beat's
# off     = take whatever ranked highest on picture quality alone
VISUAL_RELEVANCE_MODE=llm

# Floor for the lexical check: the share of a beat's search terms that must
# appear in a clip's own description. Low on purpose - a provider calling a bat
# a "grey-headed flying fox" shares no word with "brown bat" and is still the
# right shot, so this only catches clips matching neither query nor narration.
VISUAL_RELEVANCE_FLOOR=0.15

# How many of a beat's ranked candidates are put in front of the screener.
# Also the depth of judged footage a beat has: what sits below the shortlist
# was never judged, and is reached only after the neutral shot. Raise it if a
# run keeps warning that it placed unscreened clips.
VISUAL_RELEVANCE_SHORTLIST=6

# --- Step 6: Instagram caption + hashtags ---
# Reuses GEMINI_API_KEY from step 2. Everything below is optional - the
# defaults in config.py are the ones described here.

# llm       = Gemini writes the caption and tags from the script
# heuristic = lines lifted from the script + keyword tags, no API call
POST_MODE=llm

# The voice of every caption. This is the knob to turn first.
POST_TONE=curious and plainspoken - short lines, concrete detail, no hype stacking and no engagement bait

# What the closing line should do. Leave blank for no CTA.
POST_CTA=ask one question the post genuinely wants answered in the replies

# The account's subject area, used to steer the broad end of the tag mix.
# Blank = infer it from the script.
POST_NICHE=

# Instagram's hard caption limit, and the point at which the feed cuts a
# caption off with "... more". The first line is built to survive that cut.
POST_MAX_CHARS=2200
POST_HOOK_MAX_CHARS=125

# Instagram allows 30 tags and advises 3-5. 8 is enough for the recommender to
# place the reel without the caption reading as spam.
POST_HASHTAG_COUNT=8

# caption = tags close the caption
# comment = tags are kept out and written to post_comment.txt for step 7
POST_HASHTAG_PLACEMENT=caption

# Tags added to every post whatever the topic - a brand or series tag, or a
# spine that tells Instagram what the account is. Left empty the recommender
# classifies each reel from scratch: 24 reels here spent 184 tag slots on 161
# distinct tags. These are added before the banded mix and take its slots, so
# raise POST_HASHTAG_COUNT by as many as you set if you want to keep the
# per-reel tags where they were.
POST_HASHTAGS_ALWAYS=
# Tags never to use. Defaults to engagement bait that limits reach.
POST_HASHTAGS_BANNED=follow4follow,followforfollow,like4like,likeforlike,f4f,l4l,tagsforlikes,followback,followme
# Tags used by the last N posts are treated as "recently used" so consecutive
# posts do not carry an identical block. 0 disables it.
POST_HASHTAG_HISTORY_RUNS=5

# --- Hashtag volume banding ---
# "broad/mid/niche" as the generator returns them describes how the words feel,
# not how many posts the tag carries. #Piezophile is niche in the vocabulary
# sense and empty in the only sense that matters - no posts means no browsers,
# so it is not reach, only characters. These bands hold every tag to a post
# count instead. Off puts the generator's own tiers back.
TAG_VOLUME_ENABLED=true

# Below the floor a tag is dropped. The three ceilings are where niche becomes
# mid, mid becomes broad, and broad becomes too big to place in.
TAG_VOLUME_FLOOR=5000
TAG_VOLUME_NICHE_MAX=150000
TAG_VOLUME_MID_MAX=2000000
TAG_VOLUME_BROAD_MAX=25000000

# One enormous tag signals the subject; a block of them enters competitions a
# small account cannot win.
TAG_VOLUME_MAX_SATURATED=1

# Rather than post a short block, take back the largest of the dropped tags
# down to FLOOR x this. 1.0 prefers a short block to a weak one.
TAG_VOLUME_RELAX=0.2

# How long a looked-up count stays good. 0 keeps them forever. Counts written
# by hand never expire and always win. Write one with the figure Instagram
# shows on the tag's own search screen:
#     python pipeline/tagvolume.py --set marinebiology=4.2M oceanlife=430K
# Worth doing for the tags this account actually posts under. The estimator
# prices a tag by how ordinary its words are, so it is reliable at throwing
# out coinages and coarse everywhere else: tags of the same shape collide on
# one figure (#biology, #botany and #trees all read as 3,162,277), and a
# common term of art reads far smaller than it is (#marinebiology reads as
# 112,201, which is the one band a small account is told it can rank in).
TAG_VOLUME_TTL_DAYS=30

# Dotted path to a callable taking a list of tags and returning {tag: count},
# if you have a real data source. Blank uses the offline estimator, which
# prices a tag by the words in it - good enough to throw out the empty ones.
# There is no Instagram provider to point this at: the Graph API hashtag node
# carries no post count and allows 30 lookups per rolling 7 days.
TAG_VOLUME_PROVIDER=

# Words the copy must never contain, and phrases it must always contain.
POST_BANNED_WORDS=
POST_MUST_INCLUDE=

# A couple of emoji read as native; a row of them reads as a brand account.
POST_ALLOW_EMOJI=true
POST_MAX_EMOJI=2

# What to do with step 4's credits:
#   required = only what a licence demands (Pexels/Pixabay demand nothing)
#   all      = also add a courtesy "via Pexels" line
#   off      = never touch the caption
POST_ATTRIBUTION=required
POST_ATTRIBUTION_HEADER=Footage:
POST_ATTRIBUTION_MAX=6

# Alt text for step 5's cover frame - the "Write alt text" field, not the
# caption. A screen reader reads it out and Instagram reads it for what the
# picture is of, so it is short, literal, and includes any text burned into
# the cover.
#   literal = built from what step 5 recorded: the hook card, plus the
#             provider's own words for the clip that was used
#   llm     = those same words rephrased by the caption call (no extra
#             request), falling back to literal if it comes back empty
# `literal` is the default because the model cannot see the picture. Step 4's
# own image_prompt shows the cost of pretending otherwise: it asked for "a
# snailfish in the deep ocean" and the clip that got used was a jellyfish.
POST_ALT_ENABLED=true
POST_ALT_MODE=literal
POST_ALT_MAX_CHARS=100           # Instagram's alt text field

# --- Step 7: Telegram delivery ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: video defaults (used from step 4 onward) ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# --- Optional: step 5 loudness ---
# Instagram normalises playback to about -14 LUFS, and ElevenLabs renders at
# whatever level the voice sits at - without this, two reels cut a week apart
# land at audibly different volumes. Leave it on unless you are mastering the
# audio yourself.
AUDIO_NORMALIZE=true
AUDIO_LOUDNESS_TARGET=-14.0
AUDIO_LOUDNESS_PEAK=-1.5
AUDIO_LOUDNESS_RANGE=11.0

# --- Optional: step 5 music bed ---
# Drop tracks into assets/music/ - nothing is downloaded, and whatever you put
# there is yours to have licensed. Step 5 rotates between them so the same bed
# does not sit under every reel. A track.txt beside track.mp3 holding a credit
# line is treated as a credit that has to be used, and step 6 puts it in the
# post. An empty assets/music/ simply means no music.
MUSIC_ENABLED=true
# MUSIC_FILE=calm-piano.mp3      # pin one track instead of rotating
MUSIC_LOUDNESS_TARGET=-30.0      # 16 LU under the narration: present, not competing
MUSIC_DUCKING=true               # lift the bed in the gaps between lines
MUSIC_FADE_IN_SECONDS=1.0
MUSIC_FADE_OUT_SECONDS=1.5
MUSIC_REUSE_COOLDOWN_RUNS=3
# A track's sidecar can carry its tempo as well as its credit, which is what
# SHOT_SNAP_TO_BEAT below cuts to. Settings lines are kept out of the credit,
# so this stays a credit file:
#
#     "Autumn prelude" by zero-project (CC BY 3.0)
#     bpm: 92
#     offset: 0.21
#
# `offset` is where the first downbeat sits inside the file, for a track that
# does not open on one. The two below are the fallback for a track with no
# sidecar tempo of its own; 0 means no grid. Anything outside 30-300 BPM is
# treated as a typo and dropped with a warning.
# MUSIC_BPM=92
# MUSIC_BEAT_OFFSET=0.0
#
# Only some of a library will ever have a tempo - an ambient bed has no pulse
# to write down. This puts the beds that do have one first, inside whatever
# MUSIC_REUSE_COOLDOWN_RUNS has left free, so the rotation stops spending most
# of its runs on a bed the cuts cannot land on. It is a preference and not a
# filter: the beatless beds still come round when the cooldown blocks the
# others. Set it false to rotate over the library evenly again.
MUSIC_PREFER_BEAT_GRID=true

# --- Optional: step 5 pacing ---
# Cuts buy attention at the top, where there is none yet to lose, and cost
# comprehension in the middle, where the viewer is following something. A
# single rate for the whole reel spends them evenly, which is the wrong place.
# `curve` opens fast, eases out to SHOT_TARGET_SECONDS, and tightens again over
# the close. `flat` is the old behaviour.
SHOT_PACING=curve
SHOT_TARGET_SECONDS=3.2          # the steady rate through the middle
SHOT_HOOK_SECONDS=1.4            # shot length at t=0
SHOT_PACING_RAMP_SECONDS=8.0     # how long the opening takes to ease out
SHOT_OUTRO_SECONDS=2.0           # tightened back down to this at the close
SHOT_OUTRO_WINDOW_SECONDS=6.0    # over this much of the ending; 0 disables
# How far one shot may overrun what the curve asked for, as a multiple of it.
# This is the ceiling that binds: SHOT_MAX_SECONDS sits at 6.0s while the curve
# asks for 3.2s, so shot length was really decided by rounding - a window up to
# 1.49 targets long rounds to one shot and holds for all of it. Measured over
# the thirteen reels on disk, 28 of the 32 shots past 3.5s were beats holding
# one clip while a second already-downloaded clip for that beat went unused. At
# 1.25 those 34 long shots become 5 and nothing lands under the floor. 0 turns
# the rule off. It can never invent footage - still capped at twice the assets
# step 4 sourced for the beat.
SHOT_MAX_OVERRUN=1.25

# Cut on a word boundary rather than wherever the arithmetic landed. Step 5
# already knows every word's timestamp - it aligns the narration to write the
# captions - so a cut can be nudged into the gap between two words instead of
# falling through the middle of one. Note that with captions off this still
# costs one alignment: cutting on the words requires knowing where they are.
SHOT_SNAP_TO_WORDS=true
SHOT_SNAP_MAX_SECONDS=0.35       # how far a cut may be moved to find a gap

# Cut the opening of the reel on the music's beat instead of on the words. A
# cut that lands on a beat is not heard as a cut - it is heard as the track
# doing it. It only works where the bed is audible, so it is confined to the
# opening, where the fade-in has just finished and the cutting is fastest;
# past the window the words take the cuts back. A beat falling inside a spoken
# word is refused outright - cutting mid-word is the defect SHOT_SNAP_TO_WORDS
# exists to prevent, and the music does not get to override it.
#
# It needs a tempo, and nothing here can measure one: write "bpm: 92" in the
# track's .txt sidecar (see the music bed above), or set MUSIC_BPM as a
# fallback. With neither, this setting does nothing at all.
SHOT_SNAP_TO_BEAT=true
SHOT_BEAT_WINDOW_SECONDS=8.0     # how much of the opening the grid governs
SHOT_BEAT_MAX_SECONDS=0.5        # how far a cut may be moved to reach a beat

# --- Optional: step 5 motion ---
# Stills have always moved; clips never did, so a reel cut from stock video was
# a sequence of static frames that happened to have things moving inside them.
# `alternate` pushes in and pulls back in turn, so a run of shots does not read
# as one mechanical move repeated. `push` moves them all the same way, `off`
# restores the static picture. IMAGE_ZOOM below still governs stills - a still
# has no motion of its own at all, and turning clip motion off is not a reason
# to freeze it.
SHOT_MOTION=alternate
SHOT_MOTION_ZOOM=1.08            # how far a shot travels over its own length
SHOT_MOTION_HOOK_ZOOM=1.18       # the opening shot, which always pushes in
IMAGE_ZOOM=1.12                  # the push-in on a still; 1.0 = off

# --- Optional: step 5 hook card ---
# The hook in big type over the opening, while the narration says it. Feeds
# autoplay muted, and the running captions arrive three words at a time - fine
# once someone is watching, useless for deciding whether to.
HOOK_CARD_ENABLED=true
HOOK_CARD_SECONDS=2.2
HOOK_CARD_FONT_SIZE=112
HOOK_CARD_MARGIN_V=320           # measured DOWN from the top of the frame
HOOK_CARD_UPPERCASE=true

# --- Optional: step 5 sound design ---
# Drop one-shots into assets/sfx/ named for what they are - whoosh.wav rides a
# cut, impact.wav lands on the open. Several of a role are rotated between.
# Nothing is downloaded and nothing is generated, exactly like the music bed:
# an empty assets/sfx/ means no effects, which is how a fresh clone arrives.
SFX_ENABLED=true
SFX_PEAK_TARGET=-14.0            # dBFS peak, measured per file then corrected
SFX_ON_CUTS=true
SFX_LEAD_SECONDS=0.08            # placed early, so the transient lands ON the cut
SFX_MIN_GAP_SECONDS=1.6          # raise this if the effects feel busy
SFX_IMPACT_AT_OPEN=true

# --- Optional: step 5 open ---
# 0 = cut straight in. A reel is judged in its first half-second, and a fade
# spends exactly that stretch showing black. Set 0.3-0.5 for a soft open.
VIDEO_FADE_IN_SECONDS=0.0

# --- Optional: step 5 cover frame ---
# The still Instagram shows in the grid, on the profile and in search - the
# only part of a reel judged with no motion and no sound. It is rebuilt from
# the source footage rather than grabbed out of reel.mp4, which has a running
# caption burned across every frame of it.
#   auto      = the hook card when the reel has one and it clears the crop
#               below, else the best-scoring footage frame
#   hook_card = always the card
#   footage   = always footage
COVER_ENABLED=true
COVER_SOURCE=auto
COVER_FILENAME=cover.jpg
COVER_JPEG_QUALITY=2             # ffmpeg -q:v, 2 (near-lossless) to 31
COVER_SEARCH_SECONDS=15.0        # the cover comes from the top of the reel
# The tightest crop the cover is shown at. Instagram crops it differently in
# the grid, the profile and search and has changed which more than once, so
# this is a knob: it decides whether the hook card is judged to survive. At the
# 1080x1920 default the card sits 320px down - inside 4:5 (from 285px) and 3:4
# (from 240px), cut off by 1:1 (from 420px).
COVER_SAFE_ASPECT=4:5

# --- Optional: step 5b looking at what was made ---
# Every other judgement in this pipeline is made on text - the script, the beat
# list, and the stock library's own words for a clip. Nothing decoded a frame,
# and three things followed from that one absence:
#
#   * `cover_score` asks in its own docstring whether a frame is "worth a
#     stranger's tap" and answered with shot length, aspect ratio and
#     resolution. Every term was a proxy; none was the question.
#   * step 4's screener told the model that framing and production quality were
#     "handled elsewhere". They were handled nowhere.
#   * the row step 9 correlates against reach recorded shots, beats and mean
#     shot length - a description of the plan, not of the reel.
#
# Two calls per run close all three. The cost is real but small: a handful of
# frames downscaled to LOOK_FRAME_WIDTH, once before the cover is chosen and
# once after the encode. Neither can fail a run - a look that does not happen
# leaves the blind score exactly as it was, and says so in the warnings.
LOOK_ENABLED=true
LOOK_FRAME_WIDTH=540             # image tokens go with area; 540 answers both
LOOK_JPEG_QUALITY=4              # ffmpeg -q:v, softer than the cover's own
LOOK_TIMEOUT_SECONDS=180.0       # a multimodal call is slower than a text one

# The cover. Candidates are rendered with the real crop and the hook card
# burned in - the same code that writes the cover itself - and graded 0-3 on
# whether they would stop a scroll. COVER_LOOK_WEIGHT is what a perfect grade
# is worth in `cover_score`, deliberately the largest term there because it is
# the only one that is the question rather than a proxy for it. It stays a term
# and not a gate: the model sees one frame, and the proxies know things about
# the clip that one frame does not show. COVER_LOOK_VETO is subtracted when the
# model says a frame should not be a cover at all - larger than the weight, so
# a veto beats a strong blind score, and finite, so a run where every candidate
# is vetoed still ships a cover rather than none.
COVER_LOOK_ENABLED=true
COVER_LOOK_MAX_CANDIDATES=6
COVER_LOOK_WEIGHT=5.0
COVER_LOOK_VETO=6.0

# The finished reel. Samples REEL_LOOK_FRAMES frames evenly across reel.mp4
# after the encode, grades it 0-3 and names what is wrong from a closed list
# (dark, blurry, watermark, static, off_topic, caption_unreadable, repetitive,
# artifact). Changes nothing about the file - it runs so that step 9 has a
# column describing the artifact instead of the plan. The list is closed
# because step 9 turns each name into a facet, and free text would give a
# vocabulary of one-off phrasings with a sample size of one each.
#
# Measured on the reel posted 2026-09-10 (reach 14): graded 1/3, dark and
# off_topic - two of its six frames were temperate cliffs and crashing surf
# under narration about glacial collapse. The text screener had approved both,
# because the library's words for them were accurate and said nothing about
# what they showed.
REEL_LOOK_ENABLED=true
REEL_LOOK_FRAMES=6
REEL_LOOK_WARN_AT=1.0            # a grade at or below this is worth a warning

# --- Optional: step 8 the unattended run ---
# `python pipeline/run.py` is steps 0 and 2-6 in one command. These are the
# decisions it makes that a person was making in between them.
#
# The money guard: refuse to start when today already has a finished reel. The
# way the bill runs away is not one expensive run, it is a catch-up run landing
# on top of a real one. `--force` overrides it for a deliberate second reel.
RUN_ONCE_PER_DAY=true

# Read the numbers on the reels already out there at the start of every run.
# Step 9 can only compare a reading taken between PERFORMANCE_MIN_AGE_HOURS and
# PERFORMANCE_WINDOW_HOURS after posting - a 24-hour slot per reel, which no
# hand-run schedule reliably hits. Read off the ledger on 2026-09-09: of 7
# posted reels, 5 had been read only past 48h and 1 only at 5.6h, so 6 of 7 sat
# outside the window they had to be inside. A job firing once every 24 hours
# lands inside any 24-hour span, so this guarantees one usable reading each.
# It runs before the once-per-day guard, so a day that makes no reel still
# reads yesterday's, and a provider that is down costs a warning, not the reel.
RUN_FETCH_INSIGHTS=true

# How many topics off the board one run may try before giving up on the day.
# The second attempt is there for step 4 coming back with no footage, which
# does not mean the pipeline is broken - it means THIS topic cannot be shot,
# and the board has ranked alternatives sitting right there. A bad key or a
# dead ffmpeg never falls through: the next topic would fail identically, after
# paying for a script to find out. 1 = never retry.
RUN_TOPIC_ATTEMPTS=2

# Score a candidate must reach before an unattended run will make it. 0 takes
# the best of whatever the board holds, which is the right default - step 0 has
# already gated the niche and probed for footage. Raise it if you would rather
# publish nothing on a thin day; the run then ends "skipped", not "failed".
RUN_TOPIC_MIN_SCORE=0

# Housekeeping for the trail an unattended run leaves: output/logs/<stamp>.log
# holds everything the six steps printed, output/runs.json holds one line per
# run. 0 on either keeps them forever.
RUN_LOG_KEEP_DAYS=30
RUN_LEDGER_KEEP=90

# --- Optional: step 9, how the reel did ---
# `pipeline/perform.py` records what a reel did once you posted it, and reads
# it back. Nothing here changes what gets made unless PERFORMANCE_FEEDBACK is
# on, and that should stay off until the ledger holds enough reels to argue
# with. The numbers are typed in - there is no Instagram provider in the repo.

# The number a reel is judged on. A watch figure rather than views, because it
# is the one metric that does not simply climb with the follower count: views
# double when your reach doubles, whatever was in the reel.
#
# watch_ratio, not watch_through, and the difference is why this default moved.
# Instagram's average watch time counts replays, so a looped reel reports more
# watch time than it has reel - 89.5s of watching on a 37.6s reel, measured.
# watch_through is a *share of the reel* and so is capped at 1.0, which handed
# a perfect score to the worst reel in the ledger. watch_ratio is the same
# division uncapped: 2.38 stays 2.38. Below 1.0 they are identical, and both
# are stored on every reel, so switching back costs nothing.
#
# Do NOT set this to `saves` or `shares` to chase the take-away pass. This
# metric is read as a ratio to the median of the nearest reels, and a median of
# zero yields no baseline, so a metric that is zero on most reels produces an
# empty table forever - which looks identical to "measured, no effect". Saves
# and shares are read as a rate instead, in the report's SAVED OR SENT table,
# which is defined at zero and moves the first time one lands.
PERFORMANCE_METRIC=watch_ratio

# Reels either side of one being scored whose median is its baseline. Every
# figure in the report is a ratio to that, which is what takes the account's
# growth curve out of the comparison. Equal numbers on both sides, so the
# newest reel is not scored until the reels after it exist.
PERFORMANCE_BASELINE_RUNS=10

# Reels a segment needs on *both* sides of a question before the report reads
# it out. This is the setting that decides whether the thing is honest: at one
# reel a day, three that happened to do well will otherwise print as a finding.
PERFORMANCE_MIN_SAMPLES=8
# Accounts a reel had to reach before its numbers are compared with anything.
# The floor above is about how many REELS a finding rests on; this is about how
# many PEOPLE each reel's number rests on, which nothing was checking. On
# 2026-09-09 the seven posted reels reached 289, 64, 9, 6, 3, 3 and 0 accounts,
# and the one that reached nobody carried the best watch_ratio in the file
# (2.381, off one or two viewers) and was being ranked against the rest.
#
# 30 is a declared prior, not a measured threshold: there is no reach at which
# the number becomes trustworthy, only one below which it certainly is not.
# 0 compares everything, which is what the report did before this existed.
# Reels with no reach recorded are always compared - not knowing the reach is
# not knowing it was small. KEPT OR BINNED is never filtered by this.
PERFORMANCE_MIN_REACH=30

# How many accounts belonging to you see every reel - your own login and any
# alts you like your own posts from. Subtracted before anything is called
# engagement, because it is not.
#
# Measured here on 2026-09-09: eight posted reels carried likes of 3, 3, 3,
# 3, 3, 3, 3 and 4. A dead constant of three, plus one real like on the only
# reel that ever reached a real audience. A reel whose reach does not clear
# this number reached nobody, so its likes and comments are your own and the
# report counts them as zero.
#
# The stored numbers stay raw - this is applied when the report reads them,
# so changing it re-reads the same history rather than rewriting it.
PERFORMANCE_OWN_ACCOUNTS=0

# Hours after posting within which a measurement is comparable with the rest.
# A reel read at 12 hours and one read at a week are not the same measurement.
# 0 turns the window off.
PERFORMANCE_WINDOW_HOURS=48

# The other end of that window. A reel read the same evening it went out has
# not finished happening: the first reel read through the provider entered the
# ledger 5.6 hours old with three views, which is not a verdict on its hook.
# Under this age a reading is kept and shown, and compared with nothing. 0
# compares everything, however green.
PERFORMANCE_MIN_AGE_HOURS=24

# How old a reading has to be before --fetch stops re-reading the reel. Numbers
# used to be taken once, so whatever a reel happened to have the moment you ran
# --fetch was what it was judged on forever. Under this age a posted reel is
# asked about again; the older readings are kept beside the new one rather than
# overwritten. Keep it inside PERFORMANCE_WINDOW_HOURS.
PERFORMANCE_SETTLE_HOURS=36

# One thing to vary deliberately from reel to reel, so there is ever anything
# to compare. Without a trial the pipeline makes the same choice every day and
# a year of reels cannot say whether it was the right one. Arms alternate; they
# are not randomised. One of:
#
#   off        no trial
#   hook       run the hook pass on alternate reels
#   duration   a step shorter, then a step longer than step 0 suggested
#   structure  run the shape pass on alternate reels
#   takeaway   run the hand-over pass on alternate reels
#   music      a bed under alternate reels, silence under the rest
#   motion     shots move on alternate reels, are locked off on the rest
#   curiosity  score the board with the curiosity component on alternate
#              days and without it on the rest
#
# music and motion are here because the report asked for them: on 2026-09-09 it
# reported five questions that every reel ever made had answered the same way,
# and told you to set this - which at the time took four names, none of them
# the ones it was naming. The other three constants are not switches: there is
# one caption aligner, and the two component columns describe what a scorer
# found in a script rather than a choice anything makes.
#
# On "takeaway": that pass is the newest thing in step 2 and the only one aimed
# at saves and shares, which are 0 across every reel posted so far. Its weights
# are a declared prior - there has never been a save to fit them to - so the
# off arm is the only thing that can ever say whether it earned its place, and
# nothing made before 2026-09-09 is confounded with it.
#
# On "curiosity": the only arm that acts at step 0, and so the only one that
# changes *which topic gets made* rather than how a chosen topic is treated.
# Its segment reads as "did the board pick better reels", not "was this reel
# treated better". It exists because the reach exhibit asked a question no
# table could answer: across the eight reels posted by 2026-09-11 the board's
# own score did not order reach at all - the two reels carrying 353 of 381
# impressions scored 2.72 and 1.30, the highest and the lowest in the file -
# and curiosity, the one component whose job is "will a stranger stop", had
# fired on neither of them and on three of the four worst. That is enough to
# stop trusting CURIOSITY_SIGNAL_WEIGHT and nowhere near enough to replace it,
# so the arm turns the component off rather than reweighting it: any other
# number to compare 0.5 against would be a second prior invented to test the
# first. `python pipeline/topics.py --no-curiosity` scores today's board the
# same way without waiting for the rota.
#
# Not "speed", though TTS_SPEED=1.08 is the other number nothing has checked:
# step 2 derives its words-per-minute from it at import time, so varying it per
# run would leave the script written to one rate and spoken at another - the
# desync that derivation exists to prevent.
PERFORMANCE_EXPLORE=takeaway

# Whether the ledger may put a bounded "measured" component on step 0's board.
# Off. The honest use of this for a long while is a report a person reads.
PERFORMANCE_FEEDBACK=false
PERFORMANCE_MAX_ADJUST=1.0
PERFORMANCE_MIN_REELS=30

# Dotted path to something that can fetch the numbers - mypkg.mod.fetch, handed
# the waiting run ids and returning {run_id: {metric: value}}. Empty, and you
# type them in, which is the right answer for the first few weeks: no API will
# ever supply the column that matters most early on, which is the reels you
# decided not to post. Set it to pipeline.instagram.fetch to automate the rest.
PERFORMANCE_PROVIDER=

# --- Optional: step 9 via Instagram ---
# Only read when PERFORMANCE_PROVIDER=pipeline.instagram.fetch. Neither key can
# post anything; they authorise reading your own media and its insights.
#
# To get them, once:
#   1. Instagram app -> settings -> switch to a Professional account (free).
#      A personal account has no insights API at all.
#   2. developers.facebook.com -> create an app -> add the Instagram product.
#   3. Add yourself as the app's owner/tester and grant it the basic and
#      insights permissions. Reading your own account this way needs no App
#      Review - Meta lets an app's own admins and testers use permissions in
#      development mode.
#   4. Generate a token, then exchange it for a LONG-LIVED one (60 days).
#   5. Paste it in, then run: python pipeline/instagram.py --check
#      That prints the numeric id for INSTAGRAM_USER_ID. It is a number, not
#      the @handle - the handle is not a node the API answers for.
#
# `python pipeline/instagram.py --refresh` mints a fresh 60 days before it
# lapses, and prints the replacement to paste back in.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Which of Meta's two hosts answers for the token. Empty works it out from the
# token itself and is almost always right: a token minted through Instagram
# Login (they all begin "IG") is parseable only by graph.instagram.com, and one
# from the Facebook Login flow ("EAA...") only by graph.facebook.com. Sending
# either to the other host is answered "Cannot parse access token", which reads
# like an expired token and is not one - which is the whole reason this is here.
INSTAGRAM_API_HOST=

# Pinned rather than floating onto Meta's newest: the metric names are exactly
# what churns between API versions.
INSTAGRAM_API_VERSION=v21.0

# How many recent posts to read when looking for the reel a run made, and how
# far from a reel's own creation time a post may be and still be taken as that
# reel when the caption did not settle it.
INSTAGRAM_MEDIA_LIMIT=50
INSTAGRAM_MATCH_HOURS=96

# --- Optional: scheduling ---
# Read by `python pipeline/schedule.py install`, which writes them into the
# Windows Task Scheduler definition. Changing them here changes nothing until
# you install again - installing again is also how you edit the task.
SCHEDULE_TIME=17:00              # 24-hour local time. 5pm is 17:00
SCHEDULE_TASK_NAME=ReelCreatorAgent

# Run as soon as the machine is available again after a missed start. This is
# what makes a local daily job work at all: a desktop is asleep or off at 17:00
# more often than not, and without it those evenings silently make nothing.
# RUN_ONCE_PER_DAY is what stops the catch-up doubling up with a real run.
SCHEDULE_CATCH_UP=true

# Wake the machine from sleep to run. Off: waking a sleeping computer every
# evening to make a video nobody has asked for yet is more than a reel is
# worth, and the catch-up above already covers the day.
SCHEDULE_WAKE=false

# If the run exits non-zero, try again after this long, this many times. Aimed
# at what a retry actually fixes - a provider having a bad ten minutes, or a
# laptop that has not found the wifi yet. 0 on either = no retries.
SCHEDULE_RETRY_MINUTES=30
SCHEDULE_RETRY_COUNT=2

# Kill a run that has been going this long. A reel is minutes of work; an hour
# in, something is hung, and a hung run holds the once-per-day slot.
SCHEDULE_TIME_LIMIT_MINUTES=120

# Read a month rather than a week. This format is evergreen - a mechanism that
# was true last month is still true - and a month is roughly four times the
# on-niche supply for free. See TOPIC_REDDIT_WINDOW in config.py.
TOPIC_REDDIT_WINDOW=month
TOPIC_PER_SOURCE=40

# Score a candidate must reach before an unattended run makes it. Left at 0 the
# run takes the best of whatever the board holds, and on a thin day that is a
# reel about nothing. A day under the floor ends "skipped", not "failed".
RUN_TOPIC_MIN_SCORE=1.0

# The evergreen backlog, one topic per line. `evergreen` in TOPIC_SOURCES reads
# it; blank falls back to assets/topics/evergreen.txt.
# TOPIC_EVERGREEN_FILE=
